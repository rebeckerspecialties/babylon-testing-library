{
    "name": "babylon-testing-library",
    "version": "3.1.0",
    "description": "Simple utilities that encourage good testing practices for Babylon.js",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "test": "jest",
        "build": "npx tsc -p tsconfig.build.json",
        "lint": "npx eslint \"src/**/*.ts\"",
        "format:check": "npx prettier --check \"src/**/*.ts\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rebeckerspecialties/babylon-testing-library.git"
    },
    "keywords": [
        "Testing",
        "TDD",
        "Babylon",
        "XR"
    ],
    "author": "Rebecker Specialties",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rebeckerspecialties/babylon-testing-library/issues"
    },
    "homepage": "https://github.com/rebeckerspecialties/babylon-testing-library#readme",
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@babylonjs/core": "^9.12.0",
        "@babylonjs/gui": "^9.12.0",
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.4.1",
        "@types/jest": "^30.0.0",
        "babel-jest": "^30.4.1",
        "canvas": "^3.2.3",
        "eslint": "^10.4.1",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "prettier": "^3.8.4",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.61.0"
    },
    "peerDependencies": {
        "@babylonjs/core": "^7.0.0 || ^8.0.0 || ^9.0.0",
        "@babylonjs/gui": "^7.0.0 || ^8.0.0 || ^9.0.0"
    }
}
